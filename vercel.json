{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "PORT": "3000",
    "SESSION_SECRET": "@session-secret",
    "MICROSOFT_CLIENT_ID": "@microsoft-client-id"
  }
}
